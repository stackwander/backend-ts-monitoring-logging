{
  "uid": "p4-overview",
  "title": "P4 API - Monitoring and Logs",
  "description": "A beginner dashboard for the host-run Express API. Metrics come from Prometheus; structured request logs come from Loki.",
  "tags": ["p4", "learning"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Log application (APP_NAME)",
        "type": "textbox",
        "query": "backendcleants_p4",
        "current": { "text": "backendcleants_p4", "value": "backendcleants_p4" },
        "options": [{ "text": "backendcleants_p4", "value": "backendcleants_p4", "selected": true }],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Start here",
      "gridPos": { "x": 0, "y": 0, "w": 16, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "**Metrics:** API → Prometheus → Grafana. **Logs:** API → Winston → Loki → Grafana.\n\nStart the API on port 3000 and send requests to `/api/product` (401 without a token is expected). Allow at least 30 seconds for rate charts. Set `LOKI_ENABLED=true` and restart the API for logs. If you change `APP_NAME`, update the log application field above."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API scrape status",
      "description": "UP means Prometheus can scrape /metrics. It does not check MongoDB or Redis readiness.",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "p4-prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job=\"api\"}", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "noValue": "Waiting for scrape",
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests per second by route",
      "description": "Includes completed API requests and unmatched requests. /metrics is excluded. unmatched includes responses produced before route matching, such as rate-limit rejections.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "p4-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (route) (rate(http_request_duration_seconds_count{job=\"api\"}[$__rate_interval]))", "legendFormat": "{{route}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP errors per second",
      "description": "4xx are client errors, including missing credentials and rate limits. 5xx are server errors. No errors appear as zero after Prometheus is available.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "p4-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\",code=~\"4..\"}[$__rate_interval])) or vector(0)", "legendFormat": "4xx - client errors" },
        { "refId": "B", "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\",code=~\"5..\"}[$__rate_interval])) or vector(0)", "legendFormat": "5xx - server errors" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "95th percentile request duration by route",
      "description": "An estimate of the duration below which 95% of requests fall. Histogram values are measured in seconds. Idle routes may have no value.",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "p4-prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))", "legendFormat": "{{route}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Application logs",
      "description": "Expand HTTP request completed records to see method, route, statusCode, durationMs and requestId. Request headers, bodies and query strings are omitted from these records.",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "p4-loki" },
      "targets": [{ "refId": "A", "expr": "{job=\"$app\"} | json", "queryType": "range", "direction": "backward", "maxLines": 100 }],
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" }
    }
  ]
}
